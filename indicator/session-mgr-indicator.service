[Unit]
Description=session-mgr-indicator: SNI tray icon for window-placement mode
After=default.target

[Service]
# The console script installed by usher's indicator setup.sh (a venv script at
# ~/.local/bin/session-mgr-indicator). A --user service inherits no login PATH,
# so name ~/.local/bin explicitly -- the daemon shells `session-mgr toggle` (the
# core command, also there) on a left-click.
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/session-mgr-indicator
Restart=always
RestartSec=2

[Install]
WantedBy=default.target

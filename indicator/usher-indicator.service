[Unit]
Description=usher-indicator: SNI tray icon for window-placement mode
After=default.target

[Service]
# The console script installed by usher's indicator setup.sh (a venv script at
# ~/.local/bin/usher-indicator). A --user service inherits no login PATH, so
# name ~/.local/bin explicitly, because the indicator shells `usher toggle` (the
# CLI, also there) on a left-click.
Environment=PATH=%h/.local/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/usher-indicator
Restart=always
RestartSec=2

[Install]
WantedBy=default.target

#!/bin/sh
# test/run - run every usher shell test (test/*.t) and report. Non-zero if any
# fails. POSIX sh; no dependency beyond a shell, python3, and the checkout.
set -eu
_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
_rc=0
for _t in "$_dir"/*.t; do
  [ -f "$_t" ] || continue
  sh "$_t" || _rc=1
done
[ "$_rc" -eq 0 ] && echo "all usher tests passed"
exit "$_rc"

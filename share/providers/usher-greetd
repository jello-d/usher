def _t_leaves_nothing_behind(ck, path):
    """A mistyped password must not strand greetd. This is the regression."""
    OK = {"type": "success"}
    ERR = {"type": "error", "error_type": "auth_error",
           "description": "Authentication failure"}
    # lead-cancel, create, post, trail-cancel
    seen, t = _stub_greetd(path, [OK, SECRET, ERR, OK])
    s = _dial(path)
    reply, started = configure_session(s, "tester", start=True,
                                       cmd=["/bin/true"], env=["A=1"])
    s.close()
    t.join(5)
    ck("a-failed-auth-is-reported", reply["type"] == "error")
    ck("a-failed-auth-does-not-claim-to-have-started", started is False)
    ck("a-failed-auth-CANCELS-the-pending-session",
       seen[-1] == {"type": "cancel_session"})
    # AND IT OPENS WITH ONE, which is what repairs a box some earlier client
    # stranded, and is why running it again is the fix rather than the problem.
    ck("it-cancels-before-it-starts",
       seen[0] == {"type": "cancel_session"})
    # A DRY RUN AUTHENTICATES AND LEAVES NOTHING EITHER.
    seen, t = _stub_greetd(path, [OK, SECRET, OK, OK])
    s = _dial(path)
    reply, started = configure_session(s, "tester", start=False)
    s.close()
    t.join(5)
    ck("a-dry-run-succeeds-without-starting",
       reply["type"] == "success" and started is False)
    ck("a-dry-run-cancels-what-it-configured",
       seen[-1] == {"type": "cancel_session"})
    # A REAL START MUST NOT BE CANCELLED, which is the way this fix could go
    # wrong and would be invisible until a login silently did nothing.
    seen, t = _stub_greetd(path, [OK, SECRET, OK, OK])
    s = _dial(path)
    reply, started = configure_session(s, "tester", start=True,
                                       cmd=["/bin/true"], env=["A=1"])
    s.close()
    t.join(5)
    ck("a-started-session-is-not-cancelled",
       started is True and seen[-1]["type"] == "start_session")


_FIXTURES = {
    # The real shape, plus the action-group trap: a second group with its own
    # Name and Exec, which a line-by-line read would let win.
    "a/wayland-sessions/wayfire.desktop":
        "[Desktop Entry]\nName=Wayfire\n"
        "Exec=/usr/local/bin/startwayfire\nType=Application\n"
        "\n[Desktop Action new-window]\nName=NotThis\nExec=/bin/false\n",
    # The action group carries a key the MAIN group does not, which is the
    # only shape where the group filter is load-bearing: for Name and Exec,
    # `setdefault` plus `[Desktop Entry]` coming first already protects us, so
    # a fixture that only duplicated those tested setdefault and not the
    # filter. Group-blindness here makes a visible session vanish instead.
    "a/wayland-sessions/actions.desktop":
        "[Desktop Entry]\nName=HasActions\nExec=/bin/real\n"
        "Actions=new-window;\n"
        "\n[Desktop Action new-window]\nName=NotThis\nExec=/bin/false\n"
        "NoDisplay=true\n",
    # A key repeated INSIDE [Desktop Entry]: undefined per spec, so the check
    # on this pins our own tie-break rather than a requirement.
    "a/wayland-sessions/dup.desktop":
        "[Desktop Entry]\nName=First\nExec=/bin/first\nName=Second\n",
    "a/wayland-sessions/hidden.desktop":
        "[Desktop Entry]\nName=Ghost\nExec=/bin/true\nHidden=true\n",
    "a/wayland-sessions/nodisplay.desktop":
        "[Desktop Entry]\nName=Invisible\nExec=/bin/true\nNoDisplay=true\n",
    "a/wayland-sessions/noexec.desktop":
        "[Desktop Entry]\nName=Broken\n",
    "a/wayland-sessions/codes.desktop":
        "[Desktop Entry]\nName=Codes\nExec=/bin/foo %U --real %f keep\n",
    "a/wayland-sessions/twin-a.desktop":
        "[Desktop Entry]\nName=Twin\nExec=/bin/a\n",
    "a/wayland-sessions/twin-b.desktop":
        "[Desktop Entry]\nName=Twin\nExec=/bin/b\n",
    "a/xsessions/lxqt.desktop":
        "[Desktop Entry]\nName=LXQt Desktop\nExec=startlxqt\n",
    # Same relative name in a LATER data dir: the earlier one must win.

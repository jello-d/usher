def _fixture_tree():
    """Write a synthetic session registry to DISK and return (root, dirs).

    STAND-IN DICTS WOULD NOT TEST THE PARSER, and the parser is where both
    traps live (the action group, and the two visibility keys). `dirs` comes
    back in session_dirs() shape with root `a` ahead of root `b`.
    """
    root = tempfile.mkdtemp(prefix="usher-greetd-sessions-")
    for rel, body in _FIXTURES.items():
        path = os.path.join(root, rel)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(body)
    dirs = []
    for sub_root in ("a", "b"):
        for sub, kind in SESSION_KINDS:
            dirs.append((os.path.join(root, sub_root, sub), kind, sub))
    return root, dirs


def _t_desktop_parse(ck, root):
    """Reading ONE desktop file: the group filter and the key rules."""
    e = read_desktop_entry(os.path.join(root, "a/wayland-sessions",
                                        "wayfire.desktop"))
    ck("desktop-entry-reads-name-and-exec",
       e.get("Name") == "Wayfire"
       and e.get("Exec") == "/usr/local/bin/startwayfire")
    # THE TRAP, and note WHICH assertion is the real one. For Name and Exec,
    # `setdefault` plus `[Desktop Entry]` coming first already wins, so
    # asserting those proves nothing about the grouping. The key the action
    # group alone defines is the one that can only be kept out by the filter,
    # and keeping it out is what stops a visible session from vanishing.
    act = read_desktop_entry(os.path.join(root, "a/wayland-sessions",
                                          "actions.desktop"))
    ck("desktop-entry-ignores-action-groups",
       act.get("Name") == "HasActions" and act.get("Exec") == "/bin/real"
       and act.get("NoDisplay") is None)
    ck("desktop-entry-duplicate-key-takes-the-first",
       read_desktop_entry(os.path.join(root, "a/wayland-sessions",
                                       "dup.desktop")).get("Name") == "First")
    ck("desktop-entry-missing-file-is-empty",
       read_desktop_entry(os.path.join(root, "nope.desktop")) == {})


def _t_session_listing(ck, dirs):
    """Building the list of sessions the login screen would offer."""
    got = list_sessions(dirs)
    names = [s["name"] for s in got]
    ck("sessions-skip-hidden", "Ghost" not in names)
    ck("sessions-skip-nodisplay", "Invisible" not in names)
    ck("sessions-skip-an-entry-with-no-exec", "Broken" not in names)
    ck("sessions-find-the-real-one", "Wayfire" in names)
    # Same fact from the listing side: a session whose only NoDisplay sits in
    # an action group must still be offered.
    ck("sessions-keep-one-whose-action-group-says-nodisplay",
       "HasActions" in names)
    # Earlier XDG_DATA_DIRS entry wins for the same relative name, so root b's
    # shadowing wayfire.desktop must not appear at all.
    ck("earlier-data-dir-wins", "ShouldNotWin" not in names)
    kinds = {s["name"]: s["kind"] for s in got}
    ck("session-type-comes-from-the-directory",
       kinds.get("Wayfire") == "wayland"
       and kinds.get("LXQt Desktop") == "x11")
    ck("exec-strips-field-codes",
       exec_argv("/bin/foo %U --real %f keep")
       == ["/bin/foo", "--real", "keep"])
    ck("exec-keeps-a-percent-that-is-not-a-field-code",
       exec_argv("/bin/foo %%  --pct=50%") == ["/bin/foo", "%%", "--pct=50%"])
    # THE ANSWER MUST NOT DEPEND ON WHO ASKS. A desktop session exports an
    # XDG_DATA_DIRS the greeter does not have, so honouring ours made
    # `--list-sessions` describe a different registry from the login it
    # predicts. Planted here because the two agreed by luck on this box.
    was = os.environ.get("XDG_DATA_DIRS")
    os.environ["XDG_DATA_DIRS"] = "/nonexistent/planted"
    try:
        scanned = [d for d, _k, _s in session_dirs()]
    finally:
        if was is None:
            os.environ.pop("XDG_DATA_DIRS", None)
        else:
            os.environ["XDG_DATA_DIRS"] = was
    ck("session-dirs-ignore-the-callers-XDG_DATA_DIRS",
       not any("planted" in d for d in scanned)
       and "/usr/share/wayland-sessions" in scanned)


def _t_greeter_cache(ck, root):
    """Each greeter's own format, written in that greeter's own shape.

    THREE READERS AND THREE POINTER KINDS, because the formats were read off
    the real binaries and sources and no two agree. A fixture using one shape
    for all three would test nothing but our own assumption.
    """
    state = os.path.join(root, "state.toml")
    with open(state, "w", encoding="utf-8") as fh:
        fh.write('last_user = "jello"\n\n'
                 '[user_to_last_sess]\njello = "Wayfire"\n')
    ck("regreet-gives-the-users-last-session-by-name",
       _regreet_choice("jello", state) == "Wayfire")
    ck("regreet-has-nothing-for-another-user",
       _regreet_choice("nobody", state) is None)
    ck("regreet-missing-reads-as-no-choice",
       _regreet_choice("jello", os.path.join(root, "gone.toml")) is None)
    with open(os.path.join(root, "junk.toml"), "w") as fh:
        fh.write("this is not = = toml\n")
    ck("regreet-unparsable-reads-as-no-choice",
       _regreet_choice("jello", os.path.join(root, "junk.toml")) is None)

    # tuigreet: bare files, and lastsession-path WINS over lastsession,
    # because a path names one entry where a command can be shared.
    tg = os.path.join(root, "tuigreet")
    os.makedirs(tg, exist_ok=True)
    with open(os.path.join(tg, "lastsession"), "w") as fh:
        fh.write("/bin/a-command\n")
    ck("tuigreet-falls-back-to-the-command-file",
       _tuigreet_choice("jello", tg) == "/bin/a-command")
    with open(os.path.join(tg, "lastsession-path"), "w") as fh:
        fh.write("/usr/share/wayland-sessions/wayfire.desktop\n")
    ck("tuigreet-prefers-the-desktop-file-path",
       _tuigreet_choice("jello", tg)
       == "/usr/share/wayland-sessions/wayfire.desktop")
    ck("tuigreet-missing-reads-as-no-choice",
       _tuigreet_choice("jello", os.path.join(root, "nope")) is None)

    # nwg-hello: JSON, per user, and the value is a COMMAND.
    nwg = os.path.join(root, "nwg.json")
    with open(nwg, "w") as fh:
        json.dump({"user": "jello",
                   "sessions": {"jello": "/usr/local/bin/startwayfire"}}, fh)
    ck("nwg-hello-gives-the-users-last-session-as-a-command",
       _nwg_hello_choice("jello", nwg) == "/usr/local/bin/startwayfire")
    ck("nwg-hello-has-nothing-for-another-user",
       _nwg_hello_choice("nobody", nwg) is None)
    with open(os.path.join(root, "junk.json"), "w") as fh:
        fh.write("{not json")
    ck("nwg-hello-unparsable-reads-as-no-choice",
       _nwg_hello_choice("jello", os.path.join(root, "junk.json")) is None)


def _t_greeter_detect(ck):

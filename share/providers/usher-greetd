def _t_greeter_states(ck):
    """The three no-pointer states, and the probe that runs with no greeter."""
    # THE THREE STATES, which is the whole reason for this rework.
    ck("a-greeter-that-never-records-says-so",
       greeter_choice("jello", "gtkgreet") == ("gtkgreet", NEVER_RECORDS))
    ck("a-greeter-we-cannot-read-says-so",
       greeter_choice("jello", "phrog") == ("phrog", UNREADABLE))
    # ALL THREE MUST READ DIFFERENTLY, pairwise. The first version of this
    # compared only NEVER_RECORDS against UNREADABLE, so making NEVER_RECORDS
    # print the no-record wording (the exact conflation this rework exists to
    # remove) failed nothing. Found by planting it.
    _reasons = [_no_record_reason("gtkgreet", NEVER_RECORDS),
                _no_record_reason("phrog", UNREADABLE),
                _no_record_reason("regreet", NO_RECORD)]
    ck("all-three-no-record-states-read-differently",
       len(set(_reasons)) == 3
       and "dconf" in _reasons[1]
       and "does not record" in _reasons[0])
    # probe=False is "nothing detected AND do not go looking", which is the
    # only way to state this without the host's own greeter cache answering.
    ck("no-greeter-and-no-probe-reads-as-no-record",
       greeter_choice("jello", None, probe=False) == (None, NO_RECORD))

    # THE PROBE FALLBACK. Detection and the readers are both stubbed, because
    # otherwise this would be testing whether THIS box happens to have a
    # greeter running and a cache on disk, which is exactly what the two
    # checks fixed above were doing wrong. Stubbed at the globals, the way
    # this suite already stubs getpass and subprocess.run.
    _detect, _table = running_greeter, GREETERS
    try:
        globals()["running_greeter"] = lambda *a, **k: None
        globals()["GREETERS"] = (("regreet", lambda _u: "Wayfire"),)
        ck("with-no-greeter-running-a-cache-on-disk-still-answers",
           greeter_choice("jello") == ("regreet", "Wayfire"))
        globals()["GREETERS"] = (("regreet", lambda _u: "Wayfire"),
                                 ("tuigreet", lambda _u: "/x.desktop"))
        two = ""
        try:
            greeter_choice("jello")
        except SessionError as exc:
            two = str(exc)
        ck("two-greeters-disagreeing-refuses-rather-than-guessing",
           "two greeters have recorded" in two)
        globals()["GREETERS"] = (("gtkgreet", NEVER_RECORDS),)
        ck("a-probe-finding-nothing-reads-as-no-record",
           greeter_choice("jello") == (None, NO_RECORD))
    finally:
        globals()["running_greeter"] = _detect
        globals()["GREETERS"] = _table


def _t_refusals(ck, dirs):
    """Every rule that refuses rather than guesses, plus the request it builds.

    THESE ARE THE INTERESTING BEHAVIOUR, which is why they are a function of
    their own: nobody is watching the console, so what this does when it
    CANNOT decide matters more than the happy path.
    """
    entries = list_sessions(dirs)
    one = [e for e in entries if e["name"] == "Wayfire"]

    def refused(want, ents=None):
        try:
            resolve_session(want, entries if ents is None else ents, "jello")
        except SessionError as exc:
            return str(exc)
        return ""

    # ALL THREE POINTER KINDS resolve to the same entry, which is what makes
    # one code path serve greeters that store three different things. Each
    # fixture value is the shape that greeter actually writes.
    wf = os.path.join(dirs[0][0], "wayfire.desktop")
    for kind, ptr in (("name", "Wayfire"),
                      ("path", wf),
                      ("command", "/usr/local/bin/startwayfire")):
        hits, got = resolve_pointer(ptr, entries)
        ck(f"resolve-a-{kind}-pointer",
           got == kind and len(hits) == 1 and hits[0]["name"] == "Wayfire")
    ck("resolve-matches-on-Name",
       resolve_session("Wayfire", entries, "jello")["exec"]
       == "/usr/local/bin/startwayfire")
    # THE INVARIANT THE POINTER RULE EXISTS FOR, and the user's reservation:
    # a command-shaped value is MATCHED, never executed, so one the registry
    # does not contain is refused however plausible it looks.
    cmdlike = refused("/usr/local/bin/startwayfire --flag")
    ck("resolve-refuses-a-command-the-registry-does-not-contain",
       "matches no session" in cmdlike
       and "never run as a command itself" in cmdlike)
    ck("resolve-refuses-an-unknown-name",
       "matches no session" in refused("Nonesuch"))
    ck("resolve-refuses-an-ambiguous-name", "ambiguous" in refused("Twin"))
    ck("resolve-refuses-an-x11-session",
       "NOT IMPLEMENTED" in refused("LXQt Desktop"))
    ck("resolve-refuses-when-nothing-recorded-and-several-exist",
       "no recorded session choice" in refused(None))
    ck("resolve-uses-the-sole-session-when-nothing-is-recorded",
       resolve_session(None, one, "jello")["name"] == "Wayfire")



def _t_menu(ck, dirs):
    """Offering the list when nothing is recorded, and never asking nobody."""
    entries = list_sessions(dirs)
    # THE MENU: offered when a greeter records nothing, and only to somebody.
    picked = choose_session(entries, "gtkgreet", NEVER_RECORDS,
                            ask=lambda _p: "1")
    ck("the-menu-returns-the-chosen-session",
       picked is not None and picked["kind"] == "wayland")
    # The x11 entry is listed but NOT an option, so the index one past the
    # startable ones is out of range. Counted rather than hardcoded, since a
    # fixture change would otherwise make this pass vacuously.
    _ok = [e for e in entries if e["kind"] == "wayland"]
    ck("the-menu-offers-only-startable-sessions",
       len(_ok) < len(entries)
       and choose_session(entries, "gtkgreet", NEVER_RECORDS,
                          ask=lambda _p: str(len(_ok) + 1)) is None
       and choose_session(entries, "gtkgreet", NEVER_RECORDS,
                          ask=lambda _p: str(len(_ok)))["kind"] == "wayland")
    ck("the-menu-treats-a-refusal-as-no-choice",
       choose_session(entries, "gtkgreet", NEVER_RECORDS,
                      ask=lambda _p: "q") is None)
    ck("the-menu-treats-an-out-of-range-answer-as-no-choice",
       choose_session(entries, "gtkgreet", NEVER_RECORDS,
                      ask=lambda _p: "99") is None)
    # NOBODY TO ASK MEANS DO NOT ASK. THE ASSERTION IS THAT THE READER IS
    # NEVER REACHED, not that the answer is None, and the difference is the
    # whole check: with the guard deleted, input() hits EOF under a redirected
    # stdin, the EOFError handler returns None, and an outcome-only assertion
    # sees exactly what success looks like. Two planted regressions passed
    # that way before this was written as a reachability test.
    asked = []

    def _boom(_p):
        asked.append(1)
        raise AssertionError("asked with no tty")

    globals()["input"] = _boom
    try:
        # _boom RAISES, so the call has to be guarded or a regression ABORTS
        # the suite instead of failing one check. That is how this check first
        # read as "nothing failed": the run crashed, printed no `selftest
        # FAIL:` line, and the regression harness grepping for one believed it.
        quiet, reached = None, False
        try:
            quiet = choose_session(entries, "gtkgreet", NEVER_RECORDS,
                                   ask=None, isatty=lambda: False)
        except AssertionError:
            reached = True
        ck("the-menu-does-not-ask-when-there-is-no-tty",
           quiet is None and not asked and not reached)
        # And the other branch, so the guard is not simply always-off: with a
        # tty the reader IS reached, which _boom proves by being hit.
        try:
            choose_session(entries, "gtkgreet", NEVER_RECORDS,
                           ask=None, isatty=lambda: True)
        except AssertionError:
            pass
        ck("the-menu-does-ask-when-there-is-a-tty", bool(asked))
    finally:
        globals().pop("input", None)
    # A SCRIPTED CALL MUST NOT BLOCK ON A QUESTION. pick_session with the menu
    # off refuses with the list instead, which is what the seam and the
    # privileged half both rely on.
    noask = ""
    try:
        pick_session("jello", None, interactive=False, entries=entries,
                     choice=(None, NO_RECORD))
    except SessionError as exc:
        noask = str(exc)
    ck("with-the-menu-off-it-refuses-instead-of-asking",
       "not knowable" in noask)
    # The resolved session travels as one unambiguous --session.
    ck("the-resolved-session-replaces-any-given-one",
       _without_session(["-n", "--session", "Old", "login"]) == ["-n", "login"]
       and _without_session(["--session=Old", "login"]) == ["login"])



def _t_request(ck, dirs):
    """The payload handed to greetd: both halves out of the registry."""
    one = [e for e in list_sessions(dirs) if e["name"] == "Wayfire"]
    cmd, env = session_request(one[0])
    ck("request-command-comes-from-the-registry",
       cmd == ["/usr/local/bin/startwayfire"])
    # Chrome picks its backend from this. Without it the session says tty,
    # Chrome chooses X11, finds no X server and exits, so a summoned login
    # comes up with no browser and nothing reports a failure.
    ck("request-tells-the-session-it-is-wayland",
       "XDG_SESSION_TYPE=wayland" in env)
    ck("request-passes-the-summoned-flag", "USHER_SUMMONED=1" in env)


def selftest():
    """Protocol checks against a stub greetd. Needs no root and no greeter."""
    results = []

    def ck(name, cond):
        results.append((name, bool(cond)))
        print(("  ok   " if cond else "  FAIL ") + name)

    path = os.path.join(os.environ.get("TMPDIR", "/var/tmp"),
                        f"summon-selftest-{os.getpid()}.sock")
    fixtures, fdirs = _fixture_tree()
    real = getpass.getpass
    globals()["getpass"].getpass = lambda _p="": "pw"
    try:
        print("== usher-greetd selftest ==")
        _t_conversation(ck, path)
        _t_journal(ck, path)
        _t_attribution(ck, path)
        _t_refusal(ck, path)
        _t_framing(ck, path)
        _t_already_logged_in(ck)
        _t_leaves_nothing_behind(ck, path)
        _t_desktop_parse(ck, fixtures)
        _t_session_listing(ck, fdirs)
        _t_greeter_cache(ck, fixtures)
        _t_greeter_detect(ck)
        _t_greeter_states(ck)
        _t_refusals(ck, fdirs)
        _t_menu(ck, fdirs)
        _t_request(ck, fdirs)
        # A START WITH NOTHING RESOLVED MUST NOT FALL BACK, since inventing a
        # default is exactly what the retired hardcoded command did.
        bad = False
        try:
            configure_session(None, "tester", start=True)
        except ValueError:
            bad = True
        except Exception:
            pass
        ck("a-start-without-a-resolved-command-is-refused", bad)
    finally:
        globals()["getpass"].getpass = real
        if os.path.exists(path):
            os.unlink(path)
        # The literal is printed before it is removed, per the tree's rule
        # about never deleting through an unexamined variable. mkdtemp
        # raises rather than returning an empty path, and the prefix check
        # is the second belt.
        if fixtures and os.path.basename(fixtures).startswith(
                "usher-greetd-sessions-"):
            shutil.rmtree(fixtures, ignore_errors=True)
    bad = [n for n, ok in results if not ok]
    print(f"\n{len(results) - len(bad)} passed, {len(bad)} failed")
    if bad:
        print("selftest FAIL: " + ", ".join(bad))
        return 1
    print("selftest OK")
    return 0


def _without_session(argv):
    """argv with any --session removed, so the resolved one can replace it.

    Passing both would leave argparse taking the last, which is the one we
    want, but relying on that is relying on a parser detail: stripping first
    means the privileged half sees exactly one and the intent is readable.
    """
    out = []
    skip = False
    for a in argv:
        if skip:
            skip = False
        elif a == "--session":
            skip = True
        elif not a.startswith("--session="):
            out.append(a)
    return out


def do_list_sessions(user, override=None):
    """Print what this box offers and which one a login would actually pick.

    DISCOVERABILITY IS THE POINT: `--session` takes a Name from the registry,
    and without this there is nowhere a human can read those names short of
    grepping desktop files. It also prints the refusal it WOULD give, which
    makes every rule in resolve_session inspectable without a login attempt.
    """
    entries = list_sessions()
    scanned = ", ".join(d for d, _kind, _sub in session_dirs())
    print(f"usher-greetd: sessions offered (scanned {scanned}):")
    for e in entries:
        print(f"  {e['name']:<22} {e['kind']:<8} {e['exec']}")
    if not entries:
        print("  (none)")
    greeter, got = greeter_choice(user)
    print("usher-greetd: greeter on the console: "
          f"{greeter or '(none running)'}")
    if got in (NO_RECORD, NEVER_RECORDS, UNREADABLE):
        print(f"usher-greetd: recorded choice: none, because "
              f"{_no_record_reason(greeter, got)}")
    else:
        hits, kind = resolve_pointer(got, entries)
        print(f"usher-greetd: recorded choice for {user}: {got}  "
              f"(a {kind or 'pointer matching nothing'})")
    if override:
        print(f"usher-greetd: overridden on the command line: {override}")
    # Flush before anything reaches stderr, or a refusal printed there jumps
    # ahead of the listing it is about when both go to a terminal.
    sys.stdout.flush()
    # THE MENU IS OFF HERE. This verb reports what a login would do, and one
    # that stopped to ask a question would be reporting on itself.
    try:
        chosen, src = pick_session(user, override, interactive=False)
        cmd, env = session_request(chosen)
    except SessionError as e:
        print(f"usher-greetd: would REFUSE: {e}", file=sys.stderr)
        return 1
    print(f"usher-greetd: would start {chosen['name']} (via {src}): "
          f"{' '.join(cmd)}")
    print(f"usher-greetd: with {' '.join(env)}")
    return 0


def resolve_then_elevate(args):
    """Decide WHAT to start, then become root carrying the answer.

    The unprivileged half of a login, and one thing despite the two
    verbs in its name: everything it reads is world-readable, so the
    decision belongs on this side of the privilege boundary, and the
    hop is how the decision gets to the half that can act on it.
    Never returns: it either execs or fails.
    """
    # RESOLVE THE SESSION FIRST, BEFORE ANY PRIVILEGE OR ANY PROMPT. Two
    # reasons, and the second is why it moved here from after the hop:
    #
    #  - a login that cannot be resolved should cost NO password at all
    #  - when the greeter records nothing, the session MENU belongs before
    #    the two password prompts rather than wedged between them, which
    #    is where it landed when resolution ran post-sudo
    #
    # Everything it reads is world-readable (the registry, the greeter's
    # cache, /proc), so no privilege is needed to decide, only to act.
    #
    # THE IDENTITY HERE IS getuid()'s, AND THAT DOES NOT WEAKEN THE RULE in
    # the module docstring. That rule governs who a session is STARTED for,
    # which is still SUDO_UID and still checked below; this only asks whose
    # recorded default to offer, and sudo cannot change who invoked us.
    try:
        _entry, _src = pick_session(pwd.getpwuid(os.getuid()).pw_name,
                                    args.session, interactive=True)
    except SessionError as exc:
        fail(f"{exc} (`--list-sessions` shows what is available)")
    print(f"usher-greetd: session {_entry['name']} ({_src})")
    # RE-EXEC UNDER SUDO RATHER THAN REFUSE. usher reaches this through a
    # single symlink (~/.config/usher/session-start), and its contract is
    # that the provider obtains its own privilege: that is what keeps usher
    # from having to decide who should be root, and what lets the seam be a
    # plain symlink to this file with no wrapper script in between.
    #
    # sudo sets SUDO_UID, which is where the username comes from, so the
    # identity survives the hop and is still never an argument.
    if os.environ.get("USHER_GREETD_NO_SUDO"):
        fail("must run as root, because only root and _greetd may connect "
             "to the greetd socket.")
    _explain_two_prompts()
    os.environ["USHER_GREETD_NO_SUDO"] = "1"   # one hop only, never a loop
    try:
        # NO -E. This fleet's sudoers refuses it, so every login printed
        # "preserving the entire environment is not supported, '-E' is
        # ignored" before the password prompt, and the variable it was there
        # to carry never crossed anyway. Nothing is lost: sudo sets SUDO_UID
        # itself, which is where the username comes from, and the real loop
        # guard is the geteuid test above rather than the env var.
        #
        # THE RESOLVED SESSION TRAVELS AS `--session`, replacing whatever
        # the caller passed, so the privileged half re-resolves one
        # unambiguous Name and can never reach the menu or a different
        # answer. A menu answered once must not be asked again.
        os.execvp("sudo", ["sudo", sys.executable,
                           os.path.abspath(__file__)]
                  + _without_session(sys.argv[1:])
                  + ["--session", _entry["name"]])
    except OSError as e:
        fail(f"cannot re-run under sudo ({e}). Try: sudo {__file__}")


def main():
    ap = argparse.ArgumentParser(
        prog="usher-greetd",
        description="Start the console graphical session from a remote shell.")
    ap.add_argument("-n", "--dry-run", action="store_true",
                    help="authenticate, then cancel instead of starting the "
                         "session. Proves the password and the whole protocol "
                         "path without touching the display, so it is safe to "
                         "run any time a greeter is up.")
    # THE SEAM HANDS US THE ACTION AS argv, so the parser has to take it. usher
    # execs `<provider> login`, and this accepted no positional at all, so the
    # one call that matters died on `unrecognized arguments: login`. I wrote
    # both sides of that contract and never ran them against each other: the
    # dry run was always typed by hand, where no action is passed.
    #
    # `choices` rather than ignoring it, because a provider that silently
    # accepts an action it does not implement is the next version of this bug.
    ap.add_argument("action", nargs="?", default="login", choices=["login"],
                    help="what to do; the seam passes this. Only `login` is "
                         "implemented, and an unknown action is an error "
                         "rather than a quiet login.")
    # THE EDGE CASE, NOT THE DEFAULT. The greeter's own sticky choice is the
    # answer almost always, and this overrides it for the login where you want
    # something else. A NAME from the registry, never a command: see
    # resolve_session for why a root helper will not exec an arbitrary string.
    ap.add_argument("--session", metavar="NAME", default=None,
                    help="start this session instead of the greeter's last "
                         "choice. NAME is a desktop entry's Name= as shown by "
                         "the login screen (for example `Wayfire`); an "
                         "unknown one is refused with the list.")
    ap.add_argument("--list-sessions", action="store_true",
                    help="print the sessions this box offers and which one "
                         "would be started, then exit. Needs no password.")
    ap.add_argument("--selftest", action="store_true",
                    help="run the protocol checks against a stub greetd. "
                         "Needs neither root nor a live greeter, so it also "
                         "works against the INSTALLED copy.")
    args = ap.parse_args()

    if args.selftest:
        return selftest()

    if args.list_sessions:
        # BEFORE THE SUDO HOP, because it starts nothing and therefore needs no
        # privilege: a question about what is available should not cost a
        # password prompt. Reading the identity from getuid() here does not
        # weaken the rule in the module docstring, which governs starting a
        # session AS somebody; this path cannot start anything at all.
        return do_list_sessions(pwd.getpwuid(os.getuid()).pw_name,
                                args.session)

    if os.geteuid() != 0:
        resolve_then_elevate(args)
    # THE USERNAME IS NEVER AN ARGUMENT. See the module docstring: this is the
    # line that stops a root helper from being a way to log in as someone else.
    sudo_uid = os.environ.get("SUDO_UID")
    if not sudo_uid or not sudo_uid.isdigit() or int(sudo_uid) == 0:
        fail("cannot tell who invoked this (no SUDO_UID), and it will not "
             "guess. Run it through sudo as your own user.")
    user = pwd.getpwuid(int(sudo_uid)).pw_name

    live = already_logged_in(user)
    if live:
        fail(f"{user} is already logged in on the console (session {live}). "
             "Nothing to do.")

    # NORMALLY A NO-OP RE-RESOLVE, because the unprivileged half above passed
    # the answer as `--session`. It still runs, rather than trusting the
    # argument, so that `sudo usher-greetd` typed directly by a human behaves
    # the same as the seam's invocation. interactive=False: the privileged half
    # never asks a question, so a sudo-only call with no recorded choice
    # refuses with the list instead of prompting as root.
    try:
        entry, src = pick_session(user, args.session, interactive=False)
        cmd, env = session_request(entry)
    except SessionError as exc:
        fail(f"{exc} (`--list-sessions` shows what is available)")
    print(f"usher-greetd: starting {entry['name']} (via {src}): "
          f"{' '.join(cmd)}")

    sock, path = find_socket()
    print(f"usher-greetd: greeter is listening on {path}")
    try:
        reply, started = configure_session(sock, user,
                                           start=not args.dry_run,
                                           cmd=cmd, env=env)
        if reply["type"] != "success":
            # A FAILED AUTHENTICATION IS THE ONE AN AUDIT MOST WANTS, so it is
            # recorded before the exit. greetd's own description, never the
            # password, and the wording stays greetd's.
            journal(f"authentication FAILED for {user}: "
                    f"{reply.get('description') or reply.get('type')}")
            fail(f"could not log {user} in: "
                 f"{reply.get('description') or reply}. "
                 "Just run it again; a mistyped password leaves nothing "
                 "behind.")
        journal(f"authenticated {user}"
                + (" (dry run, cancelling)" if args.dry_run else ""))
        if args.dry_run:
            print(f"usher-greetd: authenticated {user}, then cancelled")
            print(f"usher-greetd: would start {' '.join(cmd)} "
                  f"with {' '.join(env)}")
            return 0
        if not started:
            fail("greetd accepted the login but did not start the session")
    finally:
        sock.close()
    _rel = release_greeter()
    journal(f"started {user}'s session; {_rel}")
    print(f"usher-greetd: session configured; {_rel}")
    print(f"usher-greetd: {user}'s session should be coming up on the console")
    return 0


if __name__ == "__main__":
    sys.exit(main())

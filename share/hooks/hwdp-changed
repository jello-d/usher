#!/bin/sh
# hwdp-changed - re-place windows when the MONITOR SET changes.
#
# usher keys its remembered layout by the connected display set (see
# `session-mgr doctor`, the `profile` line), so plugging or unplugging a
# monitor switches which layout is the right one. Nothing in the compositor
# tells usher that happened: it sees windows being shuffled by the output
# change and, in steady state, leaves them where they land.
#
# hwdp does know, and runs every executable in its `changed.d` hook dir on a
# display change. So this is the one line that connects the two.
#
# The DECISION is deliberately not made here. That edge fires on every output
# burst -- a monitor blanking and waking, a kanshi reapply, a re-detect -- not
# only when the set of monitors actually differs, so a hook that re-armed
# placement on each one would yank a deliberately-moved window home every time
# a screen blinked. `session-mgr display-changed` compares the profile against
# the last one it acted on and does nothing at all when they match; usher owns
# the notion of a profile, so usher is where that belongs.
#
# Install with `setup.sh hooks` (or let `setup.sh install` do it when hwdp's
# hook dir is already present). Safe to run by hand, and a no-op when the
# monitor set has not changed.
set -eu

command -v session-mgr >/dev/null 2>&1 || exit 0

exec session-mgr display-changed >/dev/null 2>&1
